# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# These are needed by the React front end (next step), not by the SQL setup.

# From Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional shared password to gate the whole app (and to confirm voiding an
# entry). Leave blank to disable the gate. This is a curtain, not a lock: it
# keeps out casual/accidental access but, since the app has no real backend
# auth, it does not stop a determined technical user.
VITE_APP_PASSWORD=

# Do NOT put the service_role key or the database password in a VITE_ variable.
# Anything prefixed VITE_ is shipped to the browser. Keep secrets server-side only.
